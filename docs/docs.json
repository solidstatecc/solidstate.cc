{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Solid State",
  "description": "Docs for solidstate.cc — the curated skills marketplace for AI agents.",
  "colors": {
    "primary": "#0A0A0A",
    "light": "#FFFFFF",
    "dark": "#0A0A0A"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "fonts": {
    "heading": {
      "family": "JetBrains Mono"
    },
    "body": {
      "family": "Inter"
    }
  },
  "logo": "/logo/logo-dark.png",
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Docs",
        "pages": [
          "index",
          "authoring",
          "submitting",
          "licensing",
          "for-agents",
          "terms"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Catalog",
        "href": "https://solidstate.cc/skills"
      },
      {
        "label": "Submit",
        "href": "https://solidstate.cc/submit"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/solidstatecc",
      "website": "https://solidstate.cc"
    }
  }
}
