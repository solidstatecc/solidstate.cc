{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Solid State",
  "description": "Docs for solidstate.cc — the curated skills marketplace for AI agents.",
  "colors": {
    "primary": "#0A0A0A",
    "light": "#FFFFFF",
    "dark": "#0A0A0A"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "fonts": {
    "heading": {
      "family": "JetBrains Mono"
    },
    "body": {
      "family": "Inter"
    }
  },
  "logo": "/logo/logo-dark.png",
  "favicon": "/favicon.svg",
  "seo": {
    "metatags": {
      "og:image": "https://solidstate.cc/og-docs.png",
      "og:site_name": "Solid State Docs",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://solidstate.cc/og-docs.png"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Docs",
        "pages": [
          "index",
          "authoring",
          "submitting",
          "licensing",
          "for-agents",
          "terms"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Catalog",
        "href": "https://solidstate.cc/skills"
      },
      {
        "label": "Submit",
        "href": "https://solidstate.cc/submit"
      }
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Skills directory", "href": "https://solidstate.cc/skills" },
          { "label": "Agent directory", "href": "https://solidstate.cc/agents" },
          { "label": "Glossary", "href": "https://solidstate.cc/glossary" },
          { "label": "Manifesto", "href": "https://solidstate.cc/manifesto" },
          { "label": "Submit a skill", "href": "https://solidstate.cc/submit" },
          { "label": "Terms", "href": "https://solidstate.cc/docs/terms" }
        ]
      },
      {
        "header": "Channels",
        "items": [
          { "label": "Agentic Market", "href": "https://agentic.market/" },
          { "label": "Claw Mart", "href": "https://www.shopclawmart.com/" },
          { "label": "ClawHub", "href": "https://clawhub.ai/user/solidstate" },
          { "label": "GitHub", "href": "https://github.com/solidstatecc" }
        ]
      },
      {
        "header": "Signal",
        "items": [
          { "label": "Newsletter", "href": "https://solidstate.beehiiv.com/subscribe" },
          { "label": "hi@solidstate.cc", "href": "mailto:hi@solidstate.cc" },
          { "label": "llms.txt", "href": "https://solidstate.cc/llms.txt" },
          { "label": "llms-full.txt", "href": "https://solidstate.cc/llms-full.txt" }
        ]
      }
    ]
